# Copy this file to .env for local development (never commit .env itself)

# The deployed Google Apps Script Web App URL (ends in /exec)
VITE_SHEET_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# The VAPID public key generated with `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=your-public-key-here
